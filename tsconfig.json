{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "node",
    "lib": ["ES2022", "DOM"], "strict": true, "declaration": true,
    "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "rootDir": "src", "outDir": "dist/esm"
  },
  "include": ["src/**/*.ts"]
}
